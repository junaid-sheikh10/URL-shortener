# Copy this file to .env and adjust. .env is never committed.

NODE_ENV=development
PORT=3000

# Used by docker-compose.yml to create the Postgres container
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener

# Used by the app
DATABASE_URL=postgres://shortener:change-me@localhost:5432/shortener
REDIS_URL=redis://localhost:6379
